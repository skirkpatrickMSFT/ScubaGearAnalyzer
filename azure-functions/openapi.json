{
  "swagger": "2.0",
  "info": {
    "title": "ScubaGear Analyzer API",
    "description": "CISA ScubaGear compliance analysis API. Provides baseline control lookups, Microsoft Learn documentation, ScubaGear results parsing, and AI-powered remediation chat.",
    "version": "1.0.0",
    "contact": {
      "name": "ScubaGear Analyzer"
    }
  },
  "host": "<your-function-app>.azurewebsites.net",
  "basePath": "/api",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "paths": {
    "/baseline/control": {
      "get": {
        "operationId": "GetControlInfo",
        "summary": "Get baseline control details",
        "description": "Returns detailed information about a specific CISA ScubaGear baseline control including rationale, remediation steps, NIST/MITRE mappings.",
        "parameters": [
          {
            "name": "controlId",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "The control ID (e.g. MS.AAD.1.1v1)"
          }
        ],
        "responses": {
          "200": {
            "description": "Control details",
            "schema": { "$ref": "#/definitions/ControlDetail" }
          },
          "400": { "description": "Invalid controlId format" },
          "404": { "description": "Control not found" }
        }
      }
    },
    "/baseline/controls": {
      "get": {
        "operationId": "ListControls",
        "summary": "List baseline controls",
        "description": "Lists all CISA ScubaGear AAD baseline controls. Optionally filtered by section number.",
        "parameters": [
          {
            "name": "section",
            "in": "query",
            "required": false,
            "type": "integer",
            "description": "Section number (1-8) to filter by"
          }
        ],
        "responses": {
          "200": {
            "description": "List of controls",
            "schema": {
              "type": "object",
              "properties": {
                "section": { "type": "string" },
                "count": { "type": "integer" },
                "controls": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/ControlSummary" }
                }
              }
            }
          }
        }
      }
    },
    "/baseline/remediation": {
      "get": {
        "operationId": "GetRemediation",
        "summary": "Get remediation steps",
        "description": "Returns step-by-step remediation and implementation instructions for a specific baseline control.",
        "parameters": [
          {
            "name": "controlId",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "The control ID (e.g. MS.AAD.3.1v1)"
          }
        ],
        "responses": {
          "200": {
            "description": "Remediation details",
            "schema": { "$ref": "#/definitions/RemediationResponse" }
          },
          "404": { "description": "Control not found" }
        }
      }
    },
    "/baseline/search": {
      "get": {
        "operationId": "SearchBaseline",
        "summary": "Search baseline controls",
        "description": "Searches baseline controls by keyword (e.g. MFA, guest, conditional access).",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "Search term"
          }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "schema": {
              "type": "object",
              "properties": {
                "query": { "type": "string" },
                "count": { "type": "integer" },
                "results": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/ControlSummary" }
                }
              }
            }
          }
        }
      }
    },
    "/baseline/section": {
      "get": {
        "operationId": "GetSectionSummary",
        "summary": "Get section summary",
        "description": "Returns a summary of all controls in a specific baseline section (1-8).",
        "parameters": [
          {
            "name": "number",
            "in": "query",
            "required": true,
            "type": "integer",
            "description": "Section number (1-8)"
          }
        ],
        "responses": {
          "200": {
            "description": "Section summary",
            "schema": { "$ref": "#/definitions/SectionSummary" }
          }
        }
      }
    },
    "/learn/search": {
      "get": {
        "operationId": "SearchLearn",
        "summary": "Search Microsoft Learn",
        "description": "Searches Microsoft Learn for documentation articles relevant to M365 security configuration.",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "Search query"
          },
          {
            "name": "maxResults",
            "in": "query",
            "required": false,
            "type": "integer",
            "description": "Maximum results (1-10, default 5)",
            "default": 5
          }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "schema": {
              "type": "object",
              "properties": {
                "query": { "type": "string" },
                "count": { "type": "integer" },
                "results": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/LearnResult" }
                }
              }
            }
          }
        }
      }
    },
    "/learn/control-docs": {
      "get": {
        "operationId": "GetControlDocs",
        "summary": "Get Learn docs for a control",
        "description": "Returns Microsoft Learn documentation URLs mapped to a specific ScubaGear baseline control.",
        "parameters": [
          {
            "name": "controlId",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "The control ID"
          },
          {
            "name": "fetchContent",
            "in": "query",
            "required": false,
            "type": "boolean",
            "description": "Whether to fetch full article content",
            "default": false
          }
        ],
        "responses": {
          "200": {
            "description": "Documentation references",
            "schema": {
              "type": "object",
              "properties": {
                "controlId": { "type": "string" },
                "mapped": { "type": "boolean" },
                "count": { "type": "integer" },
                "urls": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "/learn/article": {
      "get": {
        "operationId": "GetArticle",
        "summary": "Fetch a Learn article",
        "description": "Fetches and returns the content of a specific Microsoft Learn article.",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "Full Microsoft Learn article URL"
          }
        ],
        "responses": {
          "200": {
            "description": "Article content",
            "schema": { "$ref": "#/definitions/LearnArticle" }
          },
          "404": { "description": "Article not found" }
        }
      }
    },
    "/parse-results": {
      "post": {
        "operationId": "ParseResults",
        "summary": "Parse ScubaGear results",
        "description": "Parses uploaded ScubaGear TestResults.json or ScubaResults merged JSON and returns structured compliance data.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "ScubaGear TestResults.json or ScubaResults merged JSON",
            "schema": {
              "type": "object",
              "description": "Raw ScubaGear JSON output"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Parsed compliance data",
            "schema": { "$ref": "#/definitions/ParsedResults" }
          },
          "400": { "description": "Invalid or unparseable JSON" }
        }
      }
    },
    "/chat": {
      "post": {
        "operationId": "Chat",
        "summary": "AI compliance chat",
        "description": "Send a message to the AI compliance assistant. Provide assessment context for grounded answers about specific control failures and remediation.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "Chat request with message and optional assessmentContext",
            "schema": {
              "type": "object",
              "description": "Chat request body"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "AI response",
            "schema": {
              "type": "object",
              "properties": {
                "response": { "type": "string", "description": "The AI response text" },
                "timestamp": { "type": "string", "description": "ISO timestamp" }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ControlDetail": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "section": { "type": "string" },
        "sectionNumber": { "type": "integer" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "criticality": { "type": "string", "enum": ["SHALL", "SHALL NOT", "SHOULD", "SHOULD NOT"] },
        "rationale": { "type": "string" },
        "lastModified": { "type": "string" },
        "checkType": { "type": "string", "enum": ["Automated", "Manual"] },
        "configurable": { "type": "boolean" },
        "bod2501": { "type": "boolean" },
        "notes": { "type": "array", "items": { "type": "string" } },
        "nistMapping": { "type": "array", "items": { "type": "string" } },
        "mitreMapping": { "type": "array", "items": { "type": "string" } },
        "resources": { "type": "array", "items": { "type": "string" } },
        "implementation": { "type": "string" },
        "licenseRequirements": { "type": "string" }
      }
    },
    "ControlSummary": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "criticality": { "type": "string" },
        "checkType": { "type": "string" },
        "bod2501": { "type": "boolean" },
        "sectionNumber": { "type": "integer" },
        "section": { "type": "string" }
      }
    },
    "RemediationResponse": {
      "type": "object",
      "properties": {
        "controlId": { "type": "string" },
        "title": { "type": "string" },
        "rationale": { "type": "string" },
        "implementation": { "type": "string" },
        "licenseRequirements": { "type": "string" },
        "notes": { "type": "array", "items": { "type": "string" } },
        "resources": { "type": "array", "items": { "type": "string" } }
      }
    },
    "SectionSummary": {
      "type": "object",
      "properties": {
        "sectionNumber": { "type": "integer" },
        "sectionName": { "type": "string" },
        "totalControls": { "type": "integer" },
        "shallCount": { "type": "integer" },
        "shouldCount": { "type": "integer" },
        "automatedChecks": { "type": "integer" },
        "manualChecks": { "type": "integer" },
        "bod2501Count": { "type": "integer" },
        "controls": { "type": "array", "items": { "$ref": "#/definitions/ControlSummary" } }
      }
    },
    "LearnResult": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "url": { "type": "string" },
        "description": { "type": "string" },
        "lastUpdated": { "type": "string" }
      }
    },
    "LearnArticle": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "url": { "type": "string" },
        "content": { "type": "string" },
        "lastUpdated": { "type": "string" }
      }
    },
    "ParsedResults": {
      "type": "object",
      "properties": {
        "format": { "type": "string", "description": "Detected format: TestResults or ScubaResults" },
        "summary": {
          "type": "object",
          "properties": {
            "total": { "type": "integer" },
            "pass": { "type": "integer" },
            "fail": { "type": "integer" },
            "manual": { "type": "integer" },
            "thirdParty": { "type": "integer" },
            "notImplemented": { "type": "integer" },
            "omitted": { "type": "integer" },
            "overallPassRate": { "type": "integer", "description": "Pass rate percentage (0-100)" }
          }
        },
        "productBreakdown": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "product": { "type": "string" },
              "displayName": { "type": "string" },
              "total": { "type": "integer" },
              "pass": { "type": "integer" },
              "fail": { "type": "integer" },
              "passRate": { "type": "integer" }
            }
          }
        },
        "controls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "controlId": { "type": "string" },
              "product": { "type": "string" },
              "productDisplayName": { "type": "string" },
              "section": { "type": "string" },
              "status": { "type": "string" },
              "criticality": { "type": "string" },
              "reportDetails": { "type": "string" },
              "requirementMet": { "type": "boolean" },
              "isOmitted": { "type": "boolean" },
              "isIncorrectResult": { "type": "boolean" }
            }
          }
        },
        "chatContext": { "type": "string", "description": "Pre-built context string to pass to the /chat endpoint" }
      }
    }
  },
  "securityDefinitions": {
    "functionKey": {
      "type": "apiKey",
      "name": "x-functions-key",
      "in": "header",
      "description": "Azure Functions host key or function-level key"
    }
  },
  "security": [
    { "functionKey": [] }
  ]
}
