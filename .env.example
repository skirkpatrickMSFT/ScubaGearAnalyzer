# ScubaGear Analyzer — Environment Variables
# Copy this file to .env and fill in your values.
#
# Chat can use either OpenAI or Azure OpenAI / Azure AI Foundry.
# Set AI_PROVIDER, or leave it unset: it is inferred as "azure" when
# AZURE_OPENAI_ENDPOINT is set, otherwise "openai".

# ── Option 1: OpenAI ────────────────────────────────────────
OPENAI_API_KEY=<your-openai-api-key>
# OPENAI_MODEL=gpt-4o

# ── Option 2: Azure OpenAI / Azure AI Foundry ───────────────
# In Azure the function app authenticates with its Managed Identity (no key).
# Locally, DefaultAzureCredential uses your `az login`.
# AI_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=<your-model-deployment-name>
# AZURE_OPENAI_API_VERSION=2024-10-21
# Optional, local development only. Prefer Entra ID (az login) over a key.
# AZURE_OPENAI_API_KEY=<your-azure-openai-key>
