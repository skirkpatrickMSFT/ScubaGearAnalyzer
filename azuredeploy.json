      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}', variables('resultsStorageName'), 'default')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('resultsStorageName'))]"
