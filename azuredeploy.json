      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('resultsStorageName')), resourceId('Microsoft.Web/sites', variables('functionAppName')), variables('storageBlobDataReaderRoleId'))]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.Web/sites', variables('functionAppName')), '2024-04-01', 'full').identity.principalId]",
        "roleDefinitionId": "[variables('storageBlobDataReaderRoleId')]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', variables('functionAppName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('resultsStorageName'))]"
