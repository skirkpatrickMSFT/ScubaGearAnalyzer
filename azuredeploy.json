{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.49.2.45890",
      "templateHash": "6109411510468163947"
    },
    "description": "Deploys the ScubaGear Analyzer Azure Functions backend (Flex Consumption) with identity-based storage, private endpoints, Application Insights, an optional results storage account, and RBAC. After deployment, run the GitHub Actions workflow to deploy the function code, or run deploy-functions.ps1 locally."
  },
  "parameters": {
    "baseName": {
      "type": "string",
      "defaultValue": "scubagear",
      "metadata": {
        "description": "Base name used to derive resource names (e.g. scubagear → scubagear-func-xxxx)"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources"
      }
    },
    "aiProvider": {
      "type": "string",
      "defaultValue": "openai",
      "allowedValues": [
        "openai",
        "azure"
      ],
      "metadata": {
        "description": "Chat model provider: \"openai\" (OpenAI API key) or \"azure\" (Azure OpenAI / Azure AI Foundry, authenticated with the function app Managed Identity)"
      }
    },
    "openAiApiKey": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "OpenAI API key for GPT-4o chat. Required when aiProvider is \"openai\"; ignored for \"azure\"."
      }
    },
    "azureOpenAiEndpoint": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Azure OpenAI endpoint, e.g. https://<resource>.openai.azure.com. Required when aiProvider is \"azure\"."
      }
    },
    "azureOpenAiDeployment": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Name of the model deployment to call (the deployment name, not the model name). Required when aiProvider is \"azure\"."
      }
    },
    "azureOpenAiApiVersion": {
      "type": "string",
      "defaultValue": "2024-10-21",
      "metadata": {
        "description": "Azure OpenAI API version"
      }
    },
    "azureOpenAiAccountName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Name of the existing Azure OpenAI / AI Services account, used to grant the Managed Identity access. Defaults to the first label of the endpoint host."
      }
    },
    "azureOpenAiResourceGroup": {
      "type": "string",
      "defaultValue": "[resourceGroup().name]",
      "metadata": {
        "description": "Resource group of the Azure OpenAI account. Defaults to this resource group."
      }
    },
    "azureOpenAiSubscriptionId": {
      "type": "string",
      "defaultValue": "[subscription().subscriptionId]",
      "metadata": {
        "description": "Subscription of the Azure OpenAI account. Defaults to this subscription."
      }
    },
    "assignAzureOpenAiRole": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Assign Cognitive Services OpenAI User to the function app on the Azure OpenAI account. Turn off if you assign the role yourself (the deployer needs Owner or User Access Administrator on the account to assign it)."
      }
    },
    "repoUrl": {
      "type": "string",
      "defaultValue": "https://github.com/skirkpatrickMSFT/ScubaGearAnalyzer",
      "metadata": {
        "description": "GitHub repository URL. Not used by the template; retained so existing parameter files keep working."
      }
    },
    "repoBranch": {
      "type": "string",
      "defaultValue": "main",
      "metadata": {
        "description": "Branch to deploy from. Not used by the template; retained so existing parameter files keep working."
      }
    },
    "allowedOrigins": {
      "type": "string",
      "defaultValue": "https://*.powerapps.com",
      "metadata": {
        "description": "Allowed CORS origins (Power Apps domain)"
      }
    },
    "enablePrivateEndpoints": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Put the storage accounts behind private endpoints: creates a VNet, integrates the function app with it, creates private DNS zones, and disables public network access on the function app's storage. Inbound access to the function app itself stays public so the Power Platform connector can reach it."
      }
    },
    "vnetAddressPrefix": {
      "type": "string",
      "defaultValue": "10.40.0.0/24",
      "metadata": {
        "description": "Address space for the VNet (at least a /24). Only used when enablePrivateEndpoints is true."
      }
    },
    "createResultsStorage": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Create a dedicated storage account and blob container for ScubaGear results, and grant the function app's Managed Identity read access. Turn off if you already have a results account (see externalStorageAccountName)."
      }
    },
    "resultsContainerName": {
      "type": "string",
      "defaultValue": "scubagear-output",
      "metadata": {
        "description": "Name of the blob container created for ScubaGear results"
      }
    },
    "resultsStorageAccountName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Name for the results storage account that is CREATED when createResultsStorage is true (3-24 lowercase letters and digits, globally unique). Leave empty to auto-generate one."
      }
    },
    "resultsStorageAllowedIpRanges": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Public IPs or CIDR ranges allowed to reach the results storage account (e.g. where ScubaGear runs or where you upload from). With private endpoints enabled, leaving this empty disables public access to the results account entirely."
      }
    },
    "externalStorageAccountName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional: name of an EXISTING storage account (e.g. one ScubaConnect already writes to) to grant the function app's Managed Identity read access. This does not create the account; the deployment fails if it is not found. To have one created, use resultsStorageAccountName instead. Leave empty to skip."
      }
    },
    "externalStorageResourceGroup": {
      "type": "string",
      "defaultValue": "[resourceGroup().name]",
      "metadata": {
        "description": "Optional: resource group of the existing external storage account. Defaults to this resource group."
      }
    }
  },
  "variables": {
    "uniqueSuffix": "[uniqueString(resourceGroup().id)]",
    "functionAppName": "[format('{0}-func-{1}', parameters('baseName'), variables('uniqueSuffix'))]",
    "storageName": "[replace(format('{0}st{1}', parameters('baseName'), variables('uniqueSuffix')), '-', '')]",
    "resultsStorageName": "[if(not(empty(parameters('resultsStorageAccountName'))), toLower(parameters('resultsStorageAccountName')), take(toLower(replace(format('{0}res{1}', parameters('baseName'), variables('uniqueSuffix')), '-', '')), 24))]",
    "appServicePlanName": "[format('{0}-plan-{1}', parameters('baseName'), variables('uniqueSuffix'))]",
    "appInsightsName": "[format('{0}-ai-{1}', parameters('baseName'), variables('uniqueSuffix'))]",
    "azureOpenAiAccount": "[if(not(empty(parameters('azureOpenAiAccountName'))), parameters('azureOpenAiAccountName'), split(replace(replace(parameters('azureOpenAiEndpoint'), 'https://', ''), 'http://', ''), '.')[0])]",
    "aiAppSettings": "[if(equals(parameters('aiProvider'), 'azure'), createArray(createObject('name', 'AI_PROVIDER', 'value', 'azure'), createObject('name', 'AZURE_OPENAI_ENDPOINT', 'value', parameters('azureOpenAiEndpoint')), createObject('name', 'AZURE_OPENAI_DEPLOYMENT', 'value', parameters('azureOpenAiDeployment')), createObject('name', 'AZURE_OPENAI_API_VERSION', 'value', parameters('azureOpenAiApiVersion'))), createArray(createObject('name', 'AI_PROVIDER', 'value', 'openai'), createObject('name', 'OPENAI_API_KEY', 'value', parameters('openAiApiKey'))))]",
    "storageBlobDataReaderRoleId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '2a2b9908-6ea1-4ae2-8e65-a410df84e7d1')]",
    "functionStorageRoleIds": [
      "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'b7e6dc6d-f1e8-4753-8033-0f276bb0955b')]",
      "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '974c5e8b-45b9-4653-ba55-5f855dd0fb88')]",
      "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '0a9a7e1f-b9d0-4cc4-a60d-0319b160aaa3')]"
    ],
    "externalIsResultsAccount": "[and(and(parameters('createResultsStorage'), equals(toLower(parameters('externalStorageAccountName')), variables('resultsStorageName'))), equals(parameters('externalStorageResourceGroup'), resourceGroup().name))]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('storageName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "supportsHttpsTrafficOnly": true,
        "minimumTlsVersion": "TLS1_2",
        "allowBlobPublicAccess": false,
        "allowSharedKeyAccess": false,
        "defaultToOAuthAuthentication": true,
        "publicNetworkAccess": "[if(parameters('enablePrivateEndpoints'), 'Disabled', 'Enabled')]",
        "networkAcls": {
          "defaultAction": "[if(parameters('enablePrivateEndpoints'), 'Deny', 'Allow')]",
          "bypass": "AzureServices"
        }
      },
      "tags": {
        "project": "ScubaGearAnalyzer",
        "component": "functions-storage"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}', variables('storageName'), 'default')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}/{2}', variables('storageName'), 'default', 'deploymentpackage')]",
      "properties": {
        "publicAccess": "None"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', variables('storageName'), 'default')]"
      ]
    },
    {
