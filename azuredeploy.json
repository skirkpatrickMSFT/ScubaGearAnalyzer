        "[resourceId('Microsoft.Resources/deployments', 'functionStoragePrivateEndpoints')]",
        "[resourceId('Microsoft.Resources/deployments', 'network')]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]"
      ]
    },
    {
      "copy": {
        "name": "functionStorageRoleAssignments",
        "count": "[length(variables('functionStorageRoleIds'))]"
      },
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('storageName')), resourceId('Microsoft.Web/sites', variables('functionAppName')), variables('functionStorageRoleIds')[copyIndex()])]",
      "properties": {
